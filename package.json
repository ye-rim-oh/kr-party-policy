{
  "name": "kr-party-policy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --experimental-strip-types --test scripts/matching.test.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify": "npm run verify:data && npm test && npm run build",
    "research:status": "node scripts/research-status.mjs",
    "findings:apply": "node scripts/apply-findings.mjs"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
